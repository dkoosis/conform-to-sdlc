.DS_Store
# built binary (was /ferret, copied from the reference repo — this repo builds /conform-to-sdlc)
/conform-to-sdlc

# Sandbox: cache + transient artifacts (prebuilt binaries are tracked in .sandbox/bin/)
.sandbox/cache/
.sandbox/setup-report.json
.sandbox/bin/**/*.tmp
.sandbox/bin/**/*.upx
.sandbox/bin/**/*.000
# lint-locked's version-keyed golangci-lint build (ferret-oxt) — machine-local,
# rebuildable from the pin in .sandbox/project.conf, never committed.
.sandbox/bin/golangci-lint-v*
.claude/tmp/
# transient scratch (go-build caches et al. — must never ride git add -A into a PR)
/.tmp/
/tmp/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads.gate.lock

# snipe local index
.snipe/

# /team run ephemera (heartbeat logs)
.team/
ferret-kuv.5/
ferret-bbp.5/
ferret-bbp.7/
ferret-bbp.8/
ferret-7c8/
ferret-bbp.14/
.fo/
ferret-wf9.1/
ferret-j33/

# bd audit residue: passive re-export, Dolt is source of truth
.beads/interactions.jsonl
.claude/pr-dossier.json
.claude/pr-verdict.json
.claude/pr-verdict.md
.claude/worktrees/
